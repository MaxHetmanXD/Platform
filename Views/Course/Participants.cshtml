@model Platform.Models.ViewModels.CourseParticipantsViewModel
@{ ViewData["Title"] = "Учасники курсу"; Layout = null; }

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" /> <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body { background-color: #f8f9fa; color: #202124; font-family: 'Google Sans', sans-serif; }
        .google-header { background-color: #ffffff; border-bottom: 1px solid #dadce0; padding: 10px 24px; position: sticky; top: 0; z-index: 1000; }
        .global-search { max-width: 600px; width: 100%; background-color: #f1f3f4; border: none; border-radius: 8px; padding: 10px 20px; }
        .sidebar-menu a { display: block; padding: 12px 24px; color: #3c4043; text-decoration: none; border-radius: 0 24px 24px 0; font-weight: 500; margin-bottom: 4px; }
        .sidebar-menu a.active { background-color: #e8f0fe; color: #1a73e8; }
        .content-card { background: #fff; border: 1px solid #dadce0; border-radius: 8px; padding: 24px; }
        .user-list-item { background: #f8f9fa; border: 1px solid #dadce0; border-radius: 8px; padding: 12px 16px; transition: 0.2s; }
        .user-list-item:hover { box-shadow: 0 2px 5px rgba(0,0,0,0.1); border-color: #1a73e8; }
        .mini-avatar { width: 40px; height: 40px; object-fit: cover; border-radius: 50%; }
        .mini-avatar-placeholder { width: 40px; height: 40px; border-radius: 50%; background-color: #6c757d; color: white; display: flex; align-items: center; justify-content: center; }
    </style>
</head>
<body>
    <header class="google-header d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center" style="width: 200px;">
            <i class="bi bi-book text-primary fs-3 me-2"></i><span class="fs-5 fw-bold text-secondary">Platform</span>
        </div>
        <div class="d-flex align-items-center justify-content-end" style="width: 200px;">
                <a asp-controller="Notification" asp-action="Index" class="btn btn-light rounded-circle p-2 me-3" title="Повідомлення">
                    <i class="bi bi-bell fs-5 text-secondary"></i>
                </a>
            <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-primary rounded-pill px-4">Профіль</a>
        </div>
    </header>

    <div class="container-fluid mt-4">
        <nav style="--bs-breadcrumb-divider: '/';" aria-label="breadcrumb" class="ms-3 mb-4">
            <ol class="breadcrumb fs-5">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Каталог</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.CourseId" class="text-decoration-none">@Model.CourseTitle</a></li>
                <li class="breadcrumb-item active">Учасники</li>
            </ol>
        </nav>

        <div class="row">
            <div class="col-md-3">
                <nav class="sidebar-menu pe-3">
                    <a asp-controller="Home" asp-action="Index"><i class="bi bi-grid me-3"></i>Каталог курсів</a>
                    <a asp-controller="Home" asp-action="MyCourses"><i class="bi bi-journal-bookmark me-3"></i>Мої курси</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin" asp-action="Index" class="text-danger border-top mt-3 pt-3"><i class="bi bi-shield-lock me-3"></i>Для адмінів</a>
                    }
                </nav>
            </div>

            <div class="col-md-9 pb-5">
                <div class="content-card">
                    
                    <div class="d-flex mb-4 gap-2 border-bottom pb-3">
                        <a asp-action="Details" asp-route-id="@Model.CourseId" class="btn btn-outline-secondary fw-bold">Курс</a>
                        <a asp-action="Lessons" asp-route-id="@Model.CourseId" class="btn btn-outline-secondary">Уроки</a>
                        <a asp-action="Grades" asp-route-id="@Model.CourseId" class="btn btn-outline-secondary">Оцінки</a>
                        <a asp-action="Participants" asp-route-id="@Model.CourseId" class="btn btn-primary fw-bold">Учасники</a>

                        @if (Model.IsOwnerOrAdmin)
                        {
                            <a asp-action="Manage" asp-route-id="@Model.CourseId" class="btn btn-outline-dark ms-auto fw-bold"><i class="bi bi-gear"></i> Налаштування</a>
                        }
                    </div>

                    <form asp-action="Participants" method="get" class="mb-5">
                        <input type="hidden" name="id" value="@Model.CourseId" />
                        <div class="input-group w-50">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
                            <input type="text" name="searchString" class="form-control border-start-0" placeholder="Пошук за ім'ям або групою..." value="@ViewData["CurrentSearch"]">
                            <button type="submit" class="btn btn-outline-secondary">Шукати</button>
                        </div>
                    </form>

                    <h5 class="mb-3 text-primary"><i class="bi bi-person-video3"></i> Власник курсу</h5>
                    <div class="user-list-item d-flex align-items-center mb-5 w-50" style="cursor: pointer;" onclick="location.href='/Account/Profile/@Model.Owner.Id'">
                        @if (Model.Owner.AvatarId != null) { <img src="/Files/Download?id=@Model.Owner.AvatarId" class="mini-avatar" /> }
                        else { <div class="mini-avatar-placeholder"><i class="bi bi-person"></i></div> }
                        <div class="ms-3">
                            <h6 class="mb-0">@Model.Owner.Nickname</h6>
                            <small class="text-muted">Посада: @Model.Owner.SpecialField</small>
                        </div>
                    </div>

                    <h5 class="mb-3 text-success"><i class="bi bi-mortarboard"></i> Учасники курсу (@Model.EnrolledStudents.Count)</h5>
                    <div class="row row-cols-1 row-cols-md-2 g-3 mb-5">
                        @foreach(var student in Model.EnrolledStudents) {
                            <div class="col">
                                <div class="user-list-item d-flex align-items-center">
                                    <div class="d-flex align-items-center flex-grow-1" style="cursor: pointer;" onclick="location.href='/Account/Profile/@student.Id'">
                                        @if (student.AvatarId != null) { <img src="/Files/Download?id=@student.AvatarId" class="mini-avatar" /> }
                                        else { <div class="mini-avatar-placeholder"><i class="bi bi-person"></i></div> }
                                        <div class="ms-3">
                                            <h6 class="mb-0">@student.Nickname</h6>
                                            <small class="text-muted">Група: @student.SpecialField</small>
                                        </div>
                                    </div>
                                    @if(Model.IsOwnerOrAdmin) {
                                        <form asp-action="ManageParticipant" method="post" class="d-flex gap-2 ms-2">
                                            <input type="hidden" name="courseId" value="@Model.CourseId" />
                                            <input type="hidden" name="studentId" value="@student.Id" />
                                            <button type="submit" name="actionType" value="Remove" class="btn btn-sm btn-outline-warning" title="Виключити"><i class="bi bi-door-closed"></i></button>
                                            <button type="submit" name="actionType" value="Ban" class="btn btn-sm btn-outline-danger" title="Забанити"><i class="bi bi-slash-circle"></i></button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    @if (Model.IsOwnerOrAdmin)
                    {
                        <hr class="my-5" />

                        <h5 class="mb-3 text-warning"><i class="bi bi-hourglass-split"></i> Заявки на вступ (@Model.PendingStudents.Count)</h5>
                        <div class="row row-cols-1 row-cols-md-2 g-3 mb-5">
                            @foreach(var student in Model.PendingStudents) {
                                <div class="col">
                                    <div class="user-list-item d-flex align-items-center bg-white border-warning">
                                        <div class="d-flex align-items-center flex-grow-1" style="cursor: pointer;" onclick="location.href='/Account/Profile/@student.Id'">
                                            @if (student.AvatarId != null) { <img src="/Files/Download?id=@student.AvatarId" class="mini-avatar" /> }
                                            else { <div class="mini-avatar-placeholder"><i class="bi bi-person"></i></div> }
                                            <div class="ms-3">
                                                <h6 class="mb-0">@student.Nickname</h6>
                                                <small class="text-muted">Група: @student.SpecialField</small>
                                            </div>
                                        </div>
                                        <form asp-action="ManageParticipant" method="post" class="d-flex gap-1 ms-2">
                                            <input type="hidden" name="courseId" value="@Model.CourseId" />
                                            <input type="hidden" name="studentId" value="@student.Id" />
                                            <button type="submit" name="actionType" value="Reject" class="btn btn-sm btn-outline-secondary" title="Відхилити"><i class="bi bi-x-lg"></i></button>
                                            <button type="submit" name="actionType" value="Ban" class="btn btn-sm btn-outline-danger" title="Забанити"><i class="bi bi-slash-circle"></i></button>
                                            <button type="submit" name="actionType" value="Accept" class="btn btn-sm btn-success" title="Прийняти"><i class="bi bi-check-lg"></i></button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>

                        <h5 class="mb-3 text-danger"><i class="bi bi-slash-circle"></i> Забанені студенти (@Model.BannedStudents.Count)</h5>
                        <div class="row row-cols-1 row-cols-md-2 g-3">
                            @foreach(var student in Model.BannedStudents) {
                                <div class="col">
                                    <div class="user-list-item d-flex align-items-center bg-white border-danger">
                                        <div class="d-flex align-items-center flex-grow-1" style="cursor: pointer;" onclick="location.href='/Account/Profile/@student.Id'">
                                            @if (student.AvatarId != null) { <img src="/Files/Download?id=@student.AvatarId" class="mini-avatar" /> }
                                            else { <div class="mini-avatar-placeholder"><i class="bi bi-person"></i></div> }
                                            <div class="ms-3">
                                                <h6 class="mb-0">@student.Nickname</h6>
                                                <small class="text-muted">Група: @student.SpecialField</small>
                                            </div>
                                        </div>
                                        <form asp-action="ManageParticipant" method="post" class="d-flex gap-2 ms-2">
                                            <input type="hidden" name="courseId" value="@Model.CourseId" />
                                            <input type="hidden" name="studentId" value="@student.Id" />
                                            <button type="submit" name="actionType" value="Unban" class="btn btn-sm btn-outline-primary">Розбанити</button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</body>
</html>