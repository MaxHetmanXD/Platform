@model Platform.Models.ViewModels.LessonDetailsViewModel
@{ ViewData["Title"] = Model.LessonTitle; Layout = null; }

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" /> <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body { background-color: #f8f9fa; color: #202124; font-family: 'Google Sans', sans-serif; }
        .google-header { background-color: #ffffff; border-bottom: 1px solid #dadce0; padding: 10px 24px; position: sticky; top: 0; z-index: 1000; }
        .global-search { max-width: 600px; width: 100%; background-color: #f1f3f4; border: none; border-radius: 8px; padding: 10px 20px; }
        .sidebar-menu a { display: block; padding: 12px 24px; color: #3c4043; text-decoration: none; border-radius: 0 24px 24px 0; font-weight: 500; margin-bottom: 4px; }
        .sidebar-menu a.active { background-color: #e8f0fe; color: #1a73e8; }
        .content-card { background: #fff; border: 1px solid #dadce0; border-radius: 8px; padding: 24px; }
        .item-block { background: #f1f3f4; border: 1px solid #dadce0; border-radius: 6px; padding: 12px 16px; margin-bottom: 8px; display: flex; align-items: center; justify-content: space-between; transition: 0.2s; text-decoration: none; color: inherit; }
        .item-block:hover { background: #e8f0fe; border-color: #1a73e8; cursor: pointer; }
    </style>
</head>
<body>
    <header class="google-header d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center" style="width: 200px;">
            <i class="bi bi-book text-primary fs-3 me-2"></i><span class="fs-5 fw-bold text-secondary">Platform</span>
        </div>
        <div class="flex-grow-1 d-flex justify-content-center px-4">
            <input type="text" class="global-search" placeholder="Глобальний пошук по платформі...">
        </div>
        <div class="d-flex align-items-center justify-content-end" style="width: 200px;">
            <a href="#" class="btn btn-light rounded-circle p-2 me-3"><i class="bi bi-bell fs-5 text-secondary"></i></a>
            <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-primary rounded-pill px-4">Профіль</a>
        </div>
    </header>

    <div class="container-fluid mt-4">
        <nav style="--bs-breadcrumb-divider: '/';" aria-label="breadcrumb" class="ms-3 mb-4">
            <ol class="breadcrumb fs-5">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Каталог</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.CourseId" class="text-decoration-none">@Model.CourseTitle</a></li>
                <li class="breadcrumb-item"><a asp-action="Lessons" asp-route-id="@Model.CourseId" class="text-decoration-none">Уроки</a></li>
                <li class="breadcrumb-item active">@Model.LessonTitle</li>
            </ol>
        </nav>

        <div class="row">
            <div class="col-md-3">
                <nav class="sidebar-menu pe-3">
                    <a asp-controller="Home" asp-action="Index"><i class="bi bi-grid me-3"></i>Каталог курсів</a>
                    <a asp-controller="Home" asp-action="MyCourses"><i class="bi bi-journal-bookmark me-3"></i>Мої курси</a>
                    @if (User.IsInRole("Admin")) { <a asp-controller="Admin" asp-action="Index" class="text-danger border-top mt-3 pt-3"><i class="bi bi-shield-lock me-3"></i>Для адмінів</a> }
                </nav>
            </div>

            <div class="col-md-9 pb-5">
                <div class="content-card">
                    <div class="d-flex mb-4 gap-2 border-bottom pb-3">
                        <a asp-action="Details" asp-route-id="@Model.CourseId" class="btn btn-outline-secondary fw-bold">Курс</a>
                        <a asp-action="Lessons" asp-route-id="@Model.CourseId" class="btn btn-primary fw-bold">Уроки</a>
                        <a asp-action="Grades" asp-route-id="@Model.CourseId" class="btn btn-outline-secondary">Оцінки</a>
                        <a asp-action="Participants" asp-route-id="@Model.CourseId" class="btn btn-outline-secondary">Учасники</a>
                        @if (Model.IsOwnerOrAdmin) { <a asp-action="Manage" asp-route-id="@Model.CourseId" class="btn btn-outline-dark ms-auto fw-bold"><i class="bi bi-gear"></i> Налаштування</a> }
                    </div>

                    <div class="bg-light p-4 rounded border mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h2 class="mb-0 fw-bold text-primary">@Model.LessonTitle</h2>
                            @if (!Model.IsOwnerOrAdmin)
                            {
                                <span class="badge bg-warning text-dark fs-5 shadow-sm" title="Ваша середня оцінка за цей урок">
                                    <i class="bi bi-star-fill"></i> @Math.Round(Model.AverageGrade ?? 0, 1)
                                </span>
                            }
                        </div>
                        <div class="fs-6" style="white-space: pre-wrap;">@Model.LessonInfo</div>
                    </div>

                    <h5 class="mt-4 mb-3"><i class="bi bi-folder2-open text-secondary me-2"></i>Матеріали уроку</h5>
                    @if(!Model.Files.Any()) { <p class="text-muted small">Файлів немає.</p> }
                    @foreach (var file in Model.Files)
                    {
                        <a href="/Files/Download?id=@file.Id" class="item-block">
                            <div><i class="bi bi-file-earmark-text text-secondary me-2 fs-5"></i><span class="fw-medium">@file.FileName</span></div>
                            <span class="text-muted small">@file.ReadableSize <i class="bi bi-download ms-2"></i></span>
                        </a>
                    }

                    <h5 class="mt-5 mb-3"><i class="bi bi-list-check text-primary me-2"></i>Завдання</h5>
                    @if(!Model.Tasks.Any()) { <p class="text-muted small">Завдань немає.</p> }
                    @foreach (var task in Model.Tasks)
                    {
                        <a asp-action="TaskDetails" asp-route-id="@task.Id" class="item-block border-primary border-opacity-25"> <div>
                                <i class="bi bi-pencil-square text-primary me-2 fs-5"></i><span class="fw-medium">@task.Title</span>
                                @if (!Model.IsOwnerOrAdmin) { <span class="badge bg-secondary ms-2">@task.Status</span> }
                            </div>
                            <div class="text-end">
                                <div class="small text-danger"><i class="bi bi-clock-history"></i> @(task.Deadline?.ToString("dd.MM.yyyy HH:mm") ?? "Без дедлайну")</div>
                                @if (!Model.IsOwnerOrAdmin) { <div class="fw-bold text-success small">Оцінка: @task.GradeString</div> }
                            </div>
                        </a>
                    }

                    @if (Model.IsOwnerOrAdmin)
                    {
                        <div class="d-flex gap-2 mt-5 border-top pt-4">
                            <button class="btn btn-outline-primary fw-bold" data-bs-toggle="modal" data-bs-target="#editLessonModal"><i class="bi bi-pencil"></i> Редагувати урок</button>
                            
                            <form asp-action="DeleteLesson" method="post" onsubmit="return confirm('Ви впевнені? Урок, файли та всі завдання будуть видалені.');">
                                <input type="hidden" name="lessonId" value="@Model.LessonId" />
                                <button type="submit" class="btn btn-outline-danger fw-bold"><i class="bi bi-trash"></i> Видалити</button>
                            </form>

                            <form asp-action="AutoCreateTask" method="post" class="ms-auto">
                                <input type="hidden" name="lessonId" value="@Model.LessonId" />
                                <button type="submit" class="btn btn-success fw-bold">
                                <i class="bi bi-plus-lg"></i> Додати завдання
                                </button>
                            </form> </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (Model.IsOwnerOrAdmin)
    {
        <div class="modal fade" id="editLessonModal" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <form asp-action="EditLesson" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="lessonId" value="@Model.LessonId" />
                        <div class="modal-header">
                            <h5 class="modal-title">Редагування уроку</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Назва уроку</label>
                                <input type="text" name="title" class="form-control" value="@Model.LessonTitle" required />
                            </div>
                            <div class="mb-4">
                                <label class="form-label fw-bold">Опис</label>
                                <textarea name="info" class="form-control" rows="5">@Model.LessonInfo</textarea>
                            </div>

                            <div class="mb-4 p-3 bg-light rounded border">
                                <label class="form-label fw-bold"><i class="bi bi-file-earmark-plus"></i> Файли</label>
                                @foreach(var f in Model.Files)
                                {
                                    <div class="form-check text-muted small">
                                        <input class="form-check-input" type="checkbox" name="filesToRemove" value="@f.Id">
                                        <label class="form-check-label">Видалити "@f.FileName"</label>
                                    </div>
                                }
                                <input type="file" name="newFiles" class="form-control mt-2" multiple />
                                <div class="form-text">Оберіть нові файли, щоб додати їх до уроку.</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold"><i class="bi bi-shield-lock"></i> Доступність</label>
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" name="isPublic" value="true" id="isPublicToggle" @(Model.IsPublic ? "checked" : "")>
                                    <label class="form-check-label">Урок доступний для всіх учасників курсу</label>
                                </div>
                                
                                <div id="studentsSelection" class="mt-3 p-3 border rounded bg-white" style="display: @(Model.IsPublic ? "none" : "block"); max-height: 200px; overflow-y: auto;">
                                    <label class="form-label small text-muted">Оберіть студентів, які матимуть доступ:</label>
                                    @foreach(var student in Model.CourseStudents)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="allowedStudentIds" value="@student.Id" @(Model.AllowedStudentIds.Contains(student.Id) ? "checked" : "")>
                                            <label class="form-check-label">@student.Nickname (@student.SpecialField)</label>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer border-top-0">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
                            <button type="submit" class="btn btn-primary fw-bold">Зберегти зміни</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <script>
            document.getElementById('isPublicToggle').addEventListener('change', function() {
                document.getElementById('studentsSelection').style.display = this.checked ? 'none' : 'block';
            });
        </script>
    }
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>