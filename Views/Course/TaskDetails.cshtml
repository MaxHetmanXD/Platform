@model Platform.Models.ViewModels.TaskDetailsViewModel
@using Platform.Enums
@{ ViewData["Title"] = Model.TaskTitle; Layout = null; }

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" /> <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body { background-color: #f8f9fa; color: #202124; font-family: 'Google Sans', sans-serif; }
        .google-header { background-color: #ffffff; border-bottom: 1px solid #dadce0; padding: 10px 24px; position: sticky; top: 0; z-index: 1000; }
        .global-search { max-width: 600px; width: 100%; background-color: #f1f3f4; border: none; border-radius: 8px; padding: 10px 20px; }
        .sidebar-menu a { display: block; padding: 12px 24px; color: #3c4043; text-decoration: none; border-radius: 0 24px 24px 0; font-weight: 500; margin-bottom: 4px; }
        .sidebar-menu a.active { background-color: #e8f0fe; color: #1a73e8; }
        .content-card { background: #fff; border: 1px solid #dadce0; border-radius: 8px; padding: 24px; height: 100%;}
        .item-block { background: #f1f3f4; border: 1px solid #dadce0; border-radius: 6px; padding: 12px 16px; margin-bottom: 8px; display: flex; align-items: center; justify-content: space-between; transition: 0.2s; text-decoration: none; color: inherit; }
        .item-block:hover { background: #e8f0fe; border-color: #1a73e8; cursor: pointer; }
    </style>
</head>
<body>
    <header class="google-header d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center" style="width: 200px;"><i class="bi bi-book text-primary fs-3 me-2"></i><span class="fs-5 fw-bold text-secondary">Platform</span></div>
        <div class="d-flex align-items-center justify-content-end" style="width: 200px;">
            <a asp-controller="Notification" asp-action="Index" class="btn btn-light rounded-circle p-2 me-3" title="Повідомлення">
                    <i class="bi bi-bell fs-5 text-secondary"></i>
                </a><a asp-controller="Account" asp-action="Profile" class="btn btn-outline-primary rounded-pill px-4">Профіль</a></div>
    </header>

    <div class="container-fluid mt-4">
        <nav style="--bs-breadcrumb-divider: '/';" aria-label="breadcrumb" class="ms-3 mb-4">
            <ol class="breadcrumb fs-5">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Каталог</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.CourseId" class="text-decoration-none">@Model.CourseTitle</a></li>
                <li class="breadcrumb-item"><a asp-action="Lessons" asp-route-id="@Model.CourseId" class="text-decoration-none">Уроки</a></li>
                <li class="breadcrumb-item"><a asp-action="Lesson" asp-route-id="@Model.LessonId" class="text-decoration-none">Урок</a></li>
                <li class="breadcrumb-item active">@Model.TaskTitle</li>
            </ol>
        </nav>

        <div class="row">
            <div class="col-md-3">
                <nav class="sidebar-menu pe-3">
                    <a asp-controller="Home" asp-action="Index"><i class="bi bi-grid me-3"></i>Каталог курсів</a>
                    <a asp-controller="Home" asp-action="MyCourses"><i class="bi bi-journal-bookmark me-3"></i>Мої курси</a>
                    @if (User.IsInRole("Admin")) { <a asp-controller="Admin" asp-action="Index" class="text-danger border-top mt-3 pt-3"><i class="bi bi-shield-lock me-3"></i>Для адмінів</a> }
                </nav>
            </div>

            <div class="col-md-9 pb-5">
                <div class="d-flex mb-4 gap-2 border-bottom pb-3 bg-white p-3 rounded shadow-sm border">
                    <a asp-action="Details" asp-route-id="@Model.CourseId" class="btn btn-outline-secondary fw-bold">Курс</a>
                    <a asp-action="Lessons" asp-route-id="@Model.CourseId" class="btn btn-outline-secondary">Уроки</a>
                    <a asp-action="Grades" asp-route-id="@Model.CourseId" class="btn btn-outline-secondary">Оцінки</a>
                    <a asp-action="Participants" asp-route-id="@Model.CourseId" class="btn btn-outline-secondary">Учасники</a>
                    @if (Model.IsOwnerOrAdmin) { <a asp-action="Manage" asp-route-id="@Model.CourseId" class="btn btn-outline-dark ms-auto fw-bold"><i class="bi bi-gear"></i> Налаштування</a> }
                </div>

                <div class="row g-4">
                    <div class="col-md-8">
                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        @if (TempData["Message"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }
                        <div class="content-card shadow-sm">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h3 class="mb-0 fw-bold text-primary">@Model.TaskTitle</h3>
                                <span class="badge bg-success fs-6"><i class="bi bi-star"></i> Max: @Model.MaxPoints балів</span>
                            </div>
                            
                            <div class="text-danger small fw-bold mb-4">
                                <i class="bi bi-clock-history"></i> Дедлайн: @(Model.Deadline?.ToString("dd.MM.yyyy HH:mm") ?? "Без дедлайну")
                            </div>

                            <div class="bg-light p-3 rounded border mb-4 fs-6" style="white-space: pre-wrap; min-height: 150px;">@Model.TaskInfo</div>

                            <h6 class="mb-3"><i class="bi bi-paperclip text-secondary"></i> Прикріплені матеріали</h6>
                            @if(!Model.TaskFiles.Any()) { <p class="text-muted small">Файлів немає.</p> }
                            @foreach (var file in Model.TaskFiles)
                            {
                                <a href="/Files/Download?id=@file.Id" class="item-block">
                                    <div><i class="bi bi-file-earmark-text text-secondary me-2 fs-5"></i><span class="fw-medium">@file.FileName</span></div>
                                    <span class="text-muted small">@file.ReadableSize <i class="bi bi-download ms-2"></i></span>
                                </a>
                            }

                            @if (Model.IsOwnerOrAdmin)
                            {
                                <div class="d-flex gap-2 mt-5 border-top pt-4">
                                    <button class="btn btn-outline-primary fw-bold" data-bs-toggle="modal" data-bs-target="#editTaskModal"><i class="bi bi-pencil"></i> Редагувати завдання</button>
                                    <form asp-action="DeleteTask" method="post" onsubmit="return confirm('Видалити завдання та всі відповіді студентів?');">
                                        <input type="hidden" name="taskId" value="@Model.TaskId" />
                                        <button type="submit" class="btn btn-outline-danger fw-bold"><i class="bi bi-trash"></i> Видалити</button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="content-card shadow-sm bg-light">
                            <h5 class="fw-bold mb-3 border-bottom pb-2"><i class="bi bi-journal-check text-success"></i> Ваша відповідь</h5>
                            
                            @if (Model.ResponseStudentId == null)
                            {
                                <div class="text-center text-muted mt-5">
                                    <i class="bi bi-people fs-1"></i>
                                    <p class="mt-2 small">Оберіть студента на сторінці <a asp-action="Grades" asp-route-id="@Model.CourseId">Оцінки</a>, щоб переглянути його відповідь.</p>
                                </div>
                            }
                            else
                            {
                                <div class="mb-3 d-flex justify-content-between align-items-center">
                                    <span class="fw-bold">@Model.ResponseStudentNickname</span>
                                    <span class="badge bg-secondary">@Model.ResponseStatus</span>
                                </div>

                                <div class="mb-3 text-center p-3 bg-white rounded border">
                                    <h6 class="text-muted mb-1">Оцінка</h6>
                                    @if (Model.CurrentGrade != null) { <h2 class="text-success fw-bold mb-0">@Model.CurrentGrade / @Model.MaxPoints</h2> }
                                    else { <h4 class="text-muted mb-0">- / @Model.MaxPoints</h4> }
                                </div>

                                <h6 class="mt-4 mb-2 small fw-bold text-muted">ЗАВАНТАЖЕНІ ФАЙЛИ</h6>
                                @if(!Model.ResponseFiles.Any()) { <p class="text-muted small fst-italic">Нічого не завантажено.</p> }
                                @foreach (var file in Model.ResponseFiles)
                                {
                                    <div class="item-block bg-white p-2 d-flex justify-content-between align-items-center mb-2">
                                        <div class="text-truncate" style="max-width: 150px;">
                                            <i class="bi bi-file-earmark-text text-primary me-1"></i>
                                            <small>@file.FileName</small>
                                        </div>
                                        
                                        <div class="d-flex align-items-center gap-3">
                                            <a href="/Files/Download?id=@file.Id" class="text-muted" title="Завантажити">
                                                <i class="bi bi-download"></i>
                                            </a>
                                            
                                            @if (Model.IsStudent && Model.ResponseStatus != "Pending" && Model.ResponseStatus != "Checked")
                                            {
                                                <form asp-action="RemoveResponseFile" method="post" class="m-0 p-0" onsubmit="return confirm('Видалити цей файл?');">
                                                    <input type="hidden" name="taskId" value="@Model.TaskId" />
                                                    <input type="hidden" name="fileId" value="@file.Id" />
                                                    <button type="submit" class="btn btn-link text-danger p-0 m-0 border-0" title="Видалити">
                                                        <i class="bi bi-x-circle fs-5"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (Model.IsStudent)
                                {
                                    bool canEdit = (Model.ResponseStatus != "Pending" && Model.ResponseStatus != "Checked");

                                    if (canEdit)
                                    {
                                        <form asp-action="AddResponseFile" method="post" enctype="multipart/form-data" class="mt-3">
                                            <input type="hidden" name="taskId" value="@Model.TaskId" />
                                            <input type="file" name="file" class="form-control form-control-sm mb-2" required />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary w-100"><i class="bi bi-upload"></i> Завантажити файл</button>
                                        </form>

                                        <form asp-action="ToggleTaskStatus" method="post" class="mt-4">
                                            <input type="hidden" name="taskId" value="@Model.TaskId" />
                                            <button type="submit" name="action" value="Send" class="btn btn-primary w-100 fw-bold">Відправити на перевірку</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="ToggleTaskStatus" method="post" class="mt-4">
                                            <input type="hidden" name="taskId" value="@Model.TaskId" />
                                            <button type="submit" name="action" value="Return" class="btn btn-outline-danger w-100 fw-bold" onclick="return confirm('Увага! Оцінка буде скасована. Повернути завдання?');">Повернути завдання</button>
                                        </form>
                                    }
                                }

                                @if (User.IsInRole("Teacher"))
                                {
                                    if (Model.ResponseStatus == "Pending" || Model.ResponseStatus == "Checked")
                                    {
                                        <form asp-action="GradeTask" method="post" class="mt-4 border-top pt-3">
                                            <input type="hidden" name="taskId" value="@Model.TaskId" />
                                            <input type="hidden" name="studentId" value="@Model.ResponseStudentId" />
                                            
                                            <label class="form-label small fw-bold">Виставити оцінку:</label>
                                            <div class="input-group mb-2">
                                                <input type="number" name="gradeValue" class="form-control" placeholder="1" max="@Model.MaxPoints" min="0" required />
                                                <span class="input-group-text">/ @Model.MaxPoints</span>
                                            </div>
                                            <button type="submit" name="action" value="Grade" class="btn btn-success w-100 fw-bold mb-2">Оцінити</button>
                                            <button type="submit" name="action" value="Return" class="btn btn-outline-danger w-100" onclick="return confirm('Повернути завдання студенту на доопрацювання? Оцінка буде видалена.');">Повернути на доопрацювання</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <div class="alert alert-warning mt-4 small text-center">
                                            <i class="bi bi-hourglass-split"></i> Студент ще не відправив завдання на перевірку.
                                        </div>
                                    }
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.IsOwnerOrAdmin)
    {
        <div class="modal fade" id="editTaskModal" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <form asp-action="EditTask" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="taskId" value="@Model.TaskId" />
                        <div class="modal-header">
                            <h5 class="modal-title">Редагування завдання</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Назва завдання</label>
                                <input type="text" name="title" class="form-control" value="@Model.TaskTitle" required />
                            </div>
                            
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Максимальний бал</label>
                                    <input type="number" name="maxPoints" class="form-control" value="@Model.MaxPoints" required min="1" max="100"/>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Дедлайн</label>
                                    <input type="datetime-local" name="deadline" class="form-control" value="@(Model.Deadline?.ToString("yyyy-MM-ddTHH:mm"))" />
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-bold">Опис</label>
                                <textarea name="info" class="form-control" rows="5">@Model.TaskInfo</textarea>
                            </div>

                            <div class="mb-4 p-3 bg-light rounded border">
                                <label class="form-label fw-bold"><i class="bi bi-file-earmark-plus"></i> Файли завдання</label>
                                @foreach(var f in Model.TaskFiles)
                                {
                                    <div class="form-check text-muted small">
                                        <input class="form-check-input" type="checkbox" name="filesToRemove" value="@f.Id">
                                        <label class="form-check-label">Видалити "@f.FileName"</label>
                                    </div>
                                }
                                <input type="file" name="newFiles" class="form-control mt-2" multiple />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold"><i class="bi bi-shield-lock"></i> Доступність</label>
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" name="isVisible" value="true" id="isPublicToggleTask" @(Model.IsPublic ? "checked" : "")>
                                    <label class="form-check-label">Завдання доступне для всіх (кому доступний урок)</label>
                                </div>
                                
                                <div id="studentsSelectionTask" class="mt-3 p-3 border rounded bg-white" style="display: @(Model.IsPublic ? "none" : "block"); max-height: 200px; overflow-y: auto;">
                                    <label class="form-label small text-muted">Оберіть студентів:</label>
                                    @foreach(var student in Model.AvailableStudentsForTask)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="allowedStudentIds" value="@student.Id" @(Model.AllowedStudentIds.Contains(student.Id) ? "checked" : "")>
                                            <label class="form-check-label">@student.Nickname</label>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer border-top-0">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
                            <button type="submit" class="btn btn-primary fw-bold">Зберегти зміни</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <script>
            var toggle = document.getElementById('isPublicToggleTask');
            if(toggle) {
                toggle.addEventListener('change', function() {
                    document.getElementById('studentsSelectionTask').style.display = this.checked ? 'none' : 'block';
                });
            }
        </script>
    }
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>