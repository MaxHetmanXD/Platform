@using Platform.Enums
@model IEnumerable<Platform.Models.ViewModels.UserListItemViewModel>
@{ ViewData["Title"] = "Адмін - Люди"; Layout = null; }

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" /> <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body { background-color: #f8f9fa; color: #202124; font-family: 'Google Sans', sans-serif; }
        .google-header { background-color: #ffffff; border-bottom: 1px solid #dadce0; padding: 10px 24px; position: sticky; top: 0; z-index: 1000; }
        .sidebar-menu a { display: block; padding: 12px 24px; color: #3c4043; text-decoration: none; border-radius: 0 24px 24px 0; font-weight: 500; margin-bottom: 4px; }
        .sidebar-menu a.active { background-color: #e8f0fe; color: #1a73e8; }
        .admin-tab { padding: 10px 20px; border-bottom: 3px solid transparent; color: #5f6368; text-decoration: none; font-weight: 500; }
        .admin-tab.active { border-bottom-color: #1a73e8; color: #1a73e8; }
        .user-list-item { background: #fff; border: 1px solid #dadce0; border-radius: 8px; padding: 15px; margin-bottom: 10px; transition: 0.2s;}
        .user-list-item:hover { box-shadow: 0 2px 5px rgba(0,0,0,0.1); border-color: #1a73e8; }
    </style>
</head>
<body>
    <header class="google-header d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center" style="width: 200px;">
            <i class="bi bi-book text-primary fs-3 me-2"></i><span class="fs-5 fw-bold text-secondary">Platform</span>
        </div>
        <div class="d-flex align-items-center justify-content-end" style="width: 200px;">
                <a asp-controller="Notification" asp-action="Index" class="btn btn-light rounded-circle p-2 me-3" title="Повідомлення">
                    <i class="bi bi-bell fs-5 text-secondary"></i>
                </a>
            <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-primary rounded-pill px-4">Профіль</a>
        </div>
    </header>

    <div class="container-fluid mt-4">
        <div class="row">
            <div class="col-md-3">
                <nav class="sidebar-menu pe-3">
                    <a asp-controller="Home" asp-action="Index"><i class="bi bi-grid me-3"></i>Каталог курсів</a>
                    <a asp-controller="Admin" asp-action="Index" class="active text-danger border-top mt-3 pt-3"><i class="bi bi-shield-lock me-3"></i>Для адмінів</a>
                </nav>
            </div>

            <div class="col-md-9">
                <div class="d-flex border-bottom mb-4">
                    <a asp-action="Courses" class="admin-tab">Всі Курси</a>
                    <a asp-action="Users" class="admin-tab active">Користувачі</a>
                    <a href="#" class="admin-tab ms-auto text-success" data-bs-toggle="modal" data-bs-target="#createUserModal"><i class="bi bi-person-plus-fill me-1"></i> Створити користувача</a>
                </div>

                <form asp-action="Users" method="get" class="row g-3 mb-4">
                    <div class="col-md-6">
                        <input type="text" name="searchString" class="form-control" placeholder="Пошук за ніком, логіном..." value="@ViewData["CurrentSearch"]">
                    </div>
                    <div class="col-md-4">
                        <select name="sortOrder" class="form-select" onchange="this.form.submit()">
                            <option value="">За алфавітом</option>
                            <option value="lastlogin" selected="@(ViewData["CurrentSort"]?.ToString() == "lastlogin")">За останнім входом</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-outline-secondary w-100">Шукати</button>
                    </div>
                </form>

                <div class="row pb-5">
                    <div class="col-md-6">
                        <h5 class="mb-3 text-primary"><i class="bi bi-person-video3"></i> Вчителі</h5>
                        @foreach (var teacher in Model.Where(u => u.Role == UserRole.Teacher))
                        {
                            <div class="user-list-item d-flex align-items-center @(teacher.IsActive ? "" : "bg-light opacity-75")">
                                <div class="flex-grow-1" style="cursor: pointer;" onclick="location.href='/Account/Profile/@teacher.Id'">
                                    <h6 class="mb-1">
                                        @if(!teacher.IsActive) 
                                        { 
                                            <i class="bi bi-lock-fill text-danger me-1" title="Заблоковано"></i> 
                                        }
                                        @teacher.Nickname 
                                        <span class="badge bg-light text-dark ms-2 border">@teacher.SpecialField</span>
                                        
                                        @if(!teacher.IsActive) 
                                        { 
                                            <span class="badge bg-danger ms-1">Заблоковано</span> 
                                        }
                                    </h6>
                                    <small class="text-muted"><i class="bi bi-person-badge"></i> @teacher.Login | Вхід: @teacher.LastLogin.ToString("dd.MM.yyyy")</small>
                                </div>
                                
                                <div class="dropdown">
                                    <button class="btn btn-light btn-sm rounded-circle" type="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile" asp-route-id="@teacher.Id"><i class="bi bi-pencil me-2"></i> Редагувати профіль</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form asp-action="ToggleUserStatus" method="post" onsubmit="return confirm('@(teacher.IsActive ? "Ви впевнені, що хочете заблокувати цього користувача? Він втратить доступ до системи." : "Розблокувати користувача?")');">
                                                <input type="hidden" name="userId" value="@teacher.Id" />
                                                @if(teacher.IsActive) 
                                                {
                                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-lock-fill me-2"></i> Заблокувати</button>
                                                } 
                                                else 
                                                {
                                                    <button type="submit" class="dropdown-item text-success"><i class="bi bi-unlock-fill me-2"></i> Розблокувати</button>
                                                }
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="col-md-6">
                        <h5 class="mb-3 text-success"><i class="bi bi-mortarboard"></i> Студенти</h5>
                        @foreach (var student in Model.Where(u => u.Role == UserRole.Student))
                        {
                            <div class="user-list-item d-flex align-items-center @(student.IsActive ? "" : "bg-light opacity-75")">
                                <div class="flex-grow-1" style="cursor: pointer;" onclick="location.href='/Account/Profile/@student.Id'">
                                    <h6 class="mb-1">
                                        @if(!student.IsActive) 
                                        { 
                                            <i class="bi bi-lock-fill text-danger me-1" title="Заблоковано"></i> 
                                        }
                                        @student.Nickname 
                                        <span class="badge bg-light text-dark ms-2 border">@student.SpecialField</span>
                                        
                                        @if(!student.IsActive) 
                                        { 
                                            <span class="badge bg-danger ms-1">Заблоковано</span> 
                                        }
                                    </h6>
                                    <small class="text-muted"><i class="bi bi-person-badge"></i> @student.Login | Вхід: @student.LastLogin.ToString("dd.MM.yyyy")</small>
                                </div>
                                
                                <div class="dropdown">
                                    <button class="btn btn-light btn-sm rounded-circle" type="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile" asp-route-id="@student.Id"><i class="bi bi-pencil me-2"></i> Редагувати профіль</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form asp-action="ToggleUserStatus" method="post" onsubmit="return confirm('@(student.IsActive ? "Ви впевнені, що хочете заблокувати цього користувача? Він втратить доступ до системи." : "Розблокувати користувача?")');">
                                                <input type="hidden" name="userId" value="@student.Id" />
                                                @if(student.IsActive) 
                                                {
                                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-lock-fill me-2"></i> Заблокувати</button>
                                                } 
                                                else 
                                                {
                                                    <button type="submit" class="dropdown-item text-success"><i class="bi bi-unlock-fill me-2"></i> Розблокувати</button>
                                                }
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="createUserModal" tabindex="-1">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <form asp-action="CreateUser" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title">Створити користувача</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body text-center">
                        <p class="small text-muted">Оберіть роль для нового профілю. Логін та пароль згенеруються автоматично, ви зможете змінити їх на сторінці редагування.</p>
                        <button type="submit" name="roleType" value="Teacher" class="btn btn-outline-primary w-100 mb-2">
                            <i class="bi bi-person-video3"></i> Створити Вчителя
                        </button>
                        <button type="submit" name="roleType" value="Student" class="btn btn-outline-success w-100">
                            <i class="bi bi-mortarboard"></i> Створити Студента
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>