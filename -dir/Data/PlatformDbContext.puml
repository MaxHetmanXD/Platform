@startuml
class PlatformDbContext {
    + Users : DbSet<User> <<get>> <<set>>
    + Courses : DbSet<Course> <<get>> <<set>>
    + Lessons : DbSet<Lesson> <<get>> <<set>>
    + Tasks : DbSet<Task> <<get>> <<set>>
    + Responses : DbSet<StudentResponse> <<get>> <<set>>
    + Grades : DbSet<Grade> <<get>> <<set>>
    + Files : DbSet<FileModel> <<get>> <<set>>
    # <<override>> OnConfiguring(optionsBuilder:DbContextOptionsBuilder) : void
    # <<override>> OnModelCreating(modelBuilder:ModelBuilder) : void
}
DbContext <|-- PlatformDbContext
@enduml
