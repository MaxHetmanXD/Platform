@startuml
class Lesson {
    + Id : Guid <<get>>
    + Title : string <<get>> <<set>>
    + TheoryContent : string <<get>> <<set>>
    + Attachments : List<FileModel> <<get>> <<set>>
    + HasAttachments : bool <<get>>
    + Tasks : List<Task> <<get>> <<set>>
    + CourseId : Guid <<get>> <<set>>
    + Course : Course <<get>> <<set>>
    + IsPublic : bool <<get>> <<set>> = true
    + AllowedStudents : List<Student> <<get>> <<set>>
    + UpdateContent(newTitle:string, newTheory:string, isPublic:bool, newMaterials:List<FileModel>) : void
    + SetAccessibility(students:List<Student>) : void
    + AddTask(task:Task) : void
    + RemoveTask(task:Task) : void
    + GetAccessibleTasks(student:Student) : List<Task>
    + CalculateAverage(student:Student) : double
    + GetSubmissionStats() : Dictionary<string, int>
    + AttachFile(file:FileModel) : void
    + RemoveFile(file:FileModel) : bool
    + GetAttachments() : List<FileModel>
    + IsAttachmentAllowed() : bool
}
IAttachable <|-- Lesson
IAccessible <|-- Lesson
@enduml
