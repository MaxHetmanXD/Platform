@startuml
class User {
    + Id : Guid <<get>>
    + Login : string <<get>> <<set>>
    + Password : string <<get>> <<set>>
    + Nickname : string <<get>> <<set>>
    + Email : string <<get>> <<set>>
    + AvatarId : Guid? <<get>> <<set>>
    + Avatar : FileModel? <<get>> <<set>>
    + Info : string <<get>> <<set>>
    + Role : UserRole <<get>> <<set>>
    + LastLogin : DateTime <<get>> <<set>>
    + IsActive : bool <<get>> <<set>> = true
    +  <<event>> OnProfileUpdated : EventHandler<string>? 
    # User()
    + User(login:string, password:string, nickname:string, email:string, role:UserRole)
    + Deactivate() : void
    + Activate() : void
    + UpdateProfile(nickname:string, email:string, avatar:FileModel?, info:string) : void
    + ChangePassword(newPassword:string) : void
    + Authenticate(login:string, password:string) : bool
    + Logout() : void
    + GetPasswordHash() : string
    + UpdateLastLogin(timestamp:DateTime) : void
    + IsAccountActive() : bool
    + GetIdentity() : Guid
}
IAuthenticatable <|-- User
@enduml
